# Copia este archivo como infra/.env para desarrollo local.
# Todos los valores son ficticios e inseguros; sustitúyelos fuera de desarrollo.
COMPOSE_PROJECT_NAME=gesband_dev

POSTGRES_DB=gesband
POSTGRES_USER=gesband
POSTGRES_PASSWORD=development-password-change-me

DJANGO_SETTINGS_MODULE=config.settings
DJANGO_SECRET_KEY=development-only-not-a-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080

# El correo y las notificaciones reales no se activan en el entorno local.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
ACCESS_INVITATION_TTL_HOURS=168
PUSH_PROVIDER=fake

WEB_PORT=8080
WEB_CONCURRENCY=2
WEB_TIMEOUT=60
