{
	admin off
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	respond /proxy-health "ok" 200

	handle_path /static/* {
		root * /srv/static
		file_server
	}

	handle {
		reverse_proxy web:8000 {
			health_uri /health/
			health_interval 30s
			health_timeout 5s
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

