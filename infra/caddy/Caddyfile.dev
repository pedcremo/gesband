{
	auto_https off
	admin off
	# Detras de otro proxy (compose.edge.yaml) hay que creer su X-Forwarded-Proto:
	# sin esto Django veria HTTP y rechazaria las cookies seguras y el CSRF.
	servers {
		trusted_proxies static private_ranges
	}
}

:8080 {
	encode zstd gzip

	route {
		header {
			X-Content-Type-Options nosniff
			Referrer-Policy strict-origin-when-cross-origin
			-Server
		}

		@proxy_health path /proxy-health
		respond @proxy_health "ok" 200

		# APK de pruebas para los betatesters: infra/downloads/ montado en solo lectura.
		redir /descargas /descargas/ 308
		handle_path /descargas/* {
			root * /srv/downloads
			@apk path *.apk
			header @apk Content-Type application/vnd.android.package-archive
			header @apk Content-Disposition attachment
			header Cache-Control no-cache
			file_server {
				hide README.md .gitkeep
			}
		}

		handle_path /static/* {
			root * /srv/static
			file_server
		}

		handle {
			reverse_proxy web:8000 {
				health_uri /health/
				health_interval 30s
				health_timeout 5s
				health_headers {
					Host localhost
				}
			}
		}
	}
}
